{
  "name": "euclidraw-ztd-charts-extension",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:watch": "node --test --watch test/plugin.test.mjs test/manifest.test.mjs",
    "check:dist": "pnpm build && git diff --exit-code -- dist/plugin.js alid.extension.json",
    "test:host": "pnpm build && node scripts/check-host.mjs"
  },
  "dependencies": {
    "ztd-charts": "0.5.0"
  },
  "devDependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vite": "8.3.5"
  }
}
